[Unit]
Description=Tesla USB Discord Uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/root/teslausb_uploader
ExecStart=node main.js
Restart=no
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables can be set here or use .env file
# Environment="WIFI_SSID=ehbs"
# Environment="DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/..."

[Install]
WantedBy=multi-user.target
